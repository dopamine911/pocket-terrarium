# Model training on AMD Strix Halo (Radeon 8060S, gfx1151): AMD's TheRock nightly PyTorch,
# whose wheels bundle ROCm, so the host needs only the amdgpu driver (/dev/kfd, /dev/dri)
# and docker. Built on first use by harness.py (harness/hosts.toml, [images]); measured
# 2026-11-05: torch 2.10.0+rocm7.13, 0.15 s/iter for the 14M L1 model (batch 64, seq 64).
FROM python:3.12-slim
RUN pip install --no-cache-dir --index-url https://rocm.nightlies.amd.com/v2/gfx1151/ torch==2.10.0+rocm7.13.0a20260513 && pip install --no-cache-dir numpy
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends libatomic1 libgomp1 > /dev/null && rm -rf /var/lib/apt/lists/*
WORKDIR /w
